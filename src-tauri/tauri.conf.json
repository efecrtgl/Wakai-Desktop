{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wakai Desktop",
  "version": "1.0.0",
  "identifier": "com.wakai.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Wakai Desktop",
    "copyright": "© 2026 Wakai Desktop geliştiricileri",
    "category": "Productivity",
    "shortDescription": "Windows 11 için pastel piksel kedili masaüstü widget platformu",
    "longDescription": "Wakai Desktop; takvim, görev, not, saat, odak, hava durumu, müzik ve sistem widget'larını doğrudan Windows 11 masaüstü duvar kağıdının üzerine yerleştirir.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Turkish"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
